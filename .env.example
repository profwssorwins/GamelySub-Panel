# URL base da infraestrutura Cubyc (ex: http://localhost:3000 ou https://seu-dominio-cubyc.com)
CUBYC_API_URL=http://localhost:3000

# API Key do cliente/fornecedor na Cubyc (prefixo cy_ ou sk_)
CUBYC_API_KEY=

# Senha de acesso ao painel administrativo Gamely
ADMIN_PASSWORD=gamely-admin-2026

# Segredo para assinar cookies de sessão (troque em produção)
SESSION_SECRET=troque-este-segredo-em-producao-gamely
